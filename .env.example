# Copy to .env for local runs and fill in at least one key. .env is git-ignored; never commit real values.
# The team's shared tokens are stored as GitHub Actions secrets under the same names.
# The server tries providers in the order below and moves on to the next one if a call fails.

# Claude API (Anthropic). Reads images and PDFs.
CLAUDE_API_KEY=
# A second Claude API key, used when the first is missing or fails.
JOHNCLAUDE=
# OpenRouter. Reads images.
OPENROUTER_API_KEY=
# Google Gemini API. Reads images.
OPENGSA_GEMINI_API_KEY=
# Groq. Reads images.
GROQ_API_KEY=
# NVIDIA API catalog. Reads images.
NVIDIA_API_KEY=

# Optional: try providers in a different order (comma-separated: claude, johnclaude, openrouter, gemini, groq, nvidia).
LLM_PROVIDER_ORDER=
# Optional: override a provider's model, e.g. GROQ_MODEL=..., GEMINI_MODEL=..., OPENROUTER_MODEL=...

# Port for the local server (optional, default 8000)
PORT=
